{
  "version": 1,
  "rules": {
    "div.qv-box": {
      "desktop": {
        "height": "855px"
      }
    },
    "div.qv-slide:nth-child(1)": {
      "desktop": {
        "--studio-aura-enabled": "1",
        "--studio-aura-x": "0px",
        "--studio-aura-y": "94px",
        "--studio-aura-blur": "24px",
        "--studio-aura-scale": "0.87",
        "--studio-aura-opacity": "0.25",
        "--studio-aura-image": "url(\"https://thb.tildacdn.com/stor3135-6364-4736-b364-376466356263/-/resize/1100x/570805faa2a75f8ef21fc023294e5ee2.jpg\")"
      }
    },
    "div.qv-slide:nth-child(2)": {
      "desktop": {
        "--studio-aura-enabled": "1",
        "--studio-aura-x": "0px",
        "--studio-aura-y": "94px",
        "--studio-aura-blur": "24px",
        "--studio-aura-scale": "0.87",
        "--studio-aura-opacity": "0.25",
        "--studio-aura-image": "url(\"https://thb.tildacdn.com/stor6263-6265-4036-b265-373234356138/-/resize/1100x/e080bd3090e526366c92aba1f9da1769.jpg\")"
      }
    },
    "div.qv-slide:nth-child(3)": {
      "desktop": {
        "--studio-aura-enabled": "1",
        "--studio-aura-x": "0px",
        "--studio-aura-y": "94px",
        "--studio-aura-blur": "24px",
        "--studio-aura-scale": "0.87",
        "--studio-aura-opacity": "0.25",
        "--studio-aura-image": "url(\"https://thb.tildacdn.com/stor6635-6135-4565-b633-303931626436/-/resize/1100x/ce804db4424d05937a9d4a71519bbc39.jpg\")"
      }
    },
    "#catSub": {
      "desktop": {
        "display": "none"
      }
    },
    "div.cat-bar-in": {
      "desktop": {
        "align-items": "flex-start"
      }
    },
    "article.pc": {
      "desktop": {
        "display": "grid",
        "grid-template-columns": "minmax(0,1fr) auto",
        "column-gap": "12px",
        "align-content": "start"
      },
      "mobile": {
        "grid-template-columns": "minmax(0,1fr)"
      }
    },
    "article.pc > div.pc-ph": {
      "desktop": {
        "grid-column": "1 / -1"
      }
    },
    "article.pc > div.pc-meta": {
      "desktop": {
        "grid-column": "1",
        "grid-row": "2",
        "min-width": "0",
        "align-self": "last baseline"
      },
      "mobile": {
        "align-self": "start"
      }
    },
    "article.pc > span.price": {
      "desktop": {
        "grid-column": "2",
        "grid-row": "2",
        "align-self": "last baseline",
        "white-space": "nowrap",
        "text-align": "right",
        "font-weight": "400"
      },
      "mobile": {
        "grid-column": "1",
        "grid-row": "3",
        "align-self": "start",
        "text-align": "left",
        "margin-top": "0px",
        "line-height": "1.3"
      }
    },
    "section.cat-layout": {
      "mobile": {
        "padding-bottom": "88px"
      }
    }
  },
  "texts": {},
  "links": {},
  "removed": {},
  "moves": [],
  "inserts": {}
}